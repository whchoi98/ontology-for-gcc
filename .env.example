# Copy to .env (gitignored) and fill in values for local development.
# Production values come from CDK outputs + ECS task-def env, not this file.

# ─── AWS ────────────────────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
ONTOLOGY_ENV=dev

# ─── Bedrock ────────────────────────────────────────────────────────────────
# Always Sonnet 4.6 (project decision — no Haiku Lite for chat/insights).
BEDROCK_CHAT_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_EMBED_MODEL_ID=global.cohere.embed-v4:0
BEDROCK_KB_ID=
BEDROCK_GUARDRAIL_ID=
# Cross-region inference profile ARN for cohere.rerank-v3 — falls back to RRF if empty.
BEDROCK_RERANKER_INFERENCE_PROFILE_ARN=

# ─── Neptune ────────────────────────────────────────────────────────────────
# Resolved from CDK output `OntologyGccData.NeptuneClusterEndpoint` at deploy time.
NEPTUNE_ENDPOINT=

# ─── OpenSearch Serverless ──────────────────────────────────────────────────
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=ontology-gcc-dev-kb-index

# ─── AgentCore ──────────────────────────────────────────────────────────────
AGENTCORE_MEMORY_ID=

# ─── Cognito (origin auth) ──────────────────────────────────────────────────
COGNITO_USER_POOL_ID=
ORIGIN_AUTH_SECRET_ARN=
PUBLIC_DOMAIN=gcc-ontology.whchoi.net

# ─── S3 ─────────────────────────────────────────────────────────────────────
RAW_DOCS_BUCKET=
UPLOADS_BUCKET=
SYNTHETIC_DATA_BUCKET=

# ─── Aurora (sessions / metadata) ───────────────────────────────────────────
AURORA_DATABASE_NAME=ontology
AURORA_SECRET_ARN=

# ─── Web (Next.js) ──────────────────────────────────────────────────────────
# Used by web/lib/api-client.ts when running `npm run dev` outside the CF chain.
NEXT_PUBLIC_API_BASE=

# GCC-specific (Plan 1)
RETAIL_VPC_ID=               # retail VPC ID (Vpc.fromVpcAttributes)
RETAIL_VPC_AZS=              # comma-separated AZ list (e.g., ap-northeast-2a,ap-northeast-2b)
RETAIL_PUBLIC_SUBNET_IDS=    # comma-separated public subnet IDs
RETAIL_PRIVATE_SUBNET_IDS=   # comma-separated private subnet IDs
RETAIL_ISOLATED_SUBNET_IDS=  # comma-separated isolated subnet IDs (Neptune)
NEPTUNE_BULK_LOADER_ROLE_ARN= # IAM role ARN for Neptune bulk loader (Phase 2)
