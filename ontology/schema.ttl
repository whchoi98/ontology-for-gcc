@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix gcc:  <https://amzn.tech/gcc/ontology#> .

# ==== Classes (22) ====

# BOM 계층 (4)
gcc:Product       a owl:Class ; rdfs:label "Product" .
gcc:Module        a owl:Class ; rdfs:label "Module" .
gcc:Component     a owl:Class ; rdfs:label "Component" .
gcc:RawMaterial   a owl:Class ; rdfs:label "RawMaterial" .

# Supply 양면 (5)
gcc:Manufacturer    a owl:Class ; rdfs:label "Manufacturer" .
gcc:Supplier        a owl:Class ; rdfs:label "Supplier" .
gcc:SubSupplier     a owl:Class ; rdfs:label "SubSupplier" .
gcc:CustomerAccount a owl:Class ; rdfs:label "CustomerAccount" .
gcc:Plant           a owl:Class ; rdfs:label "Plant" .

# Geo / 운송 (2)
gcc:Region    a owl:Class ; rdfs:label "Region" .
gcc:TradeLane a owl:Class ; rdfs:label "TradeLane" .

# 표준 / 규제 (4)
gcc:Standard      a owl:Class ; rdfs:label "Standard" .
gcc:Certification a owl:Class ; rdfs:label "Certification" .
gcc:Regulation    a owl:Class ; rdfs:label "Regulation" .
gcc:Substance     a owl:Class ; rdfs:label "Substance" .

# 품질 (3)
gcc:QualityIncident a owl:Class ; rdfs:label "QualityIncident" .
gcc:EightDReport    a owl:Class ; rdfs:label "EightDReport" .
gcc:RootCause       a owl:Class ; rdfs:label "RootCause" .

# 운영 / ESG (4)
gcc:Telemetry        a owl:Class ; rdfs:label "Telemetry" .
gcc:MaintenanceEvent a owl:Class ; rdfs:label "MaintenanceEvent" .
gcc:ESGIndicator     a owl:Class ; rdfs:label "ESGIndicator" .
gcc:CarbonScope      a owl:Class ; rdfs:label "CarbonScope" .

# ==== Object Properties (relations, 18+) ====

# BOM
gcc:hasModule    a owl:ObjectProperty ; rdfs:domain gcc:Product ;   rdfs:range gcc:Module .
gcc:consistsOf   a owl:ObjectProperty ; rdfs:domain gcc:Module ;    rdfs:range gcc:Component .
gcc:madeOf       a owl:ObjectProperty ; rdfs:domain gcc:Component ; rdfs:range gcc:RawMaterial .

# Supply
gcc:manufacturedBy a owl:ObjectProperty ; rdfs:domain gcc:Product ;      rdfs:range gcc:Manufacturer .
gcc:operates       a owl:ObjectProperty ; rdfs:domain gcc:Manufacturer ; rdfs:range gcc:Plant .
gcc:locatedIn      a owl:ObjectProperty ; rdfs:domain gcc:Plant ;        rdfs:range gcc:Region .
gcc:suppliedBy     a owl:ObjectProperty ; rdfs:domain gcc:Component ;    rdfs:range gcc:Supplier .
gcc:subSupplies    a owl:ObjectProperty ; rdfs:domain gcc:Supplier ;     rdfs:range gcc:SubSupplier .
gcc:soldTo         a owl:ObjectProperty ; rdfs:domain gcc:Product ;      rdfs:range gcc:CustomerAccount .

# Lane
gcc:connects     a owl:ObjectProperty ; rdfs:domain gcc:TradeLane ; rdfs:range gcc:Region .
gcc:shipsVia     a owl:ObjectProperty ; rdfs:domain gcc:Plant ;     rdfs:range gcc:TradeLane .
gcc:subjectTo    a owl:ObjectProperty ; rdfs:domain gcc:TradeLane ; rdfs:range gcc:Regulation .

# Compliance
gcc:conformsTo       a owl:ObjectProperty ; rdfs:domain gcc:Component ; rdfs:range gcc:Standard .
gcc:certifiedBy      a owl:ObjectProperty ; rdfs:domain gcc:Component ; rdfs:range gcc:Certification .
gcc:containsSubstance a owl:ObjectProperty ; rdfs:domain gcc:Component ; rdfs:range gcc:Substance .
gcc:regulatedBy      a owl:ObjectProperty ; rdfs:domain gcc:Substance ; rdfs:range gcc:Regulation .

# Quality
gcc:about        a owl:ObjectProperty ; rdfs:domain gcc:QualityIncident ; rdfs:range gcc:Component .
gcc:addresses    a owl:ObjectProperty ; rdfs:domain gcc:EightDReport ;    rdfs:range gcc:QualityIncident .
gcc:identifies   a owl:ObjectProperty ; rdfs:domain gcc:EightDReport ;    rdfs:range gcc:RootCause .
gcc:linkedTo     a owl:ObjectProperty ; rdfs:domain gcc:RootCause ;       rdfs:range gcc:Supplier .

# Ops / ESG
gcc:from        a owl:ObjectProperty ; rdfs:domain gcc:Telemetry ;        rdfs:range gcc:Plant .
gcc:on          a owl:ObjectProperty ; rdfs:domain gcc:MaintenanceEvent ; rdfs:range gcc:Component .
gcc:measuredAt  a owl:ObjectProperty ; rdfs:domain gcc:ESGIndicator ;     rdfs:range gcc:Plant .
gcc:emits       a owl:ObjectProperty ; rdfs:domain gcc:Plant ;            rdfs:range gcc:CarbonScope .
